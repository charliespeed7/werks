{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Werks design tokens. Tier 1 primitives + Tier 2 semantic aliases. Format: W3C DTCG draft. Source of truth for tokens.css, tokens.ts and the Tailwind configs — regenerate those from this file, never the other way round.",
  "$version": "1.0.0",

  "colour": {
    "$type": "color",
    "paper": {
      "white": { "$value": "#FFFFFF" },
      "50":  { "$value": "#FBFAF8", "$description": "App canvas, light theme" },
      "100": { "$value": "#F5F3EF" },
      "200": { "$value": "#EBE8E2" },
      "300": { "$value": "#DCD8D0" },
      "400": { "$value": "#C2BDB3" }
    },
    "ink": {
      "400": { "$value": "#96918A" },
      "450": { "$value": "#8C877F", "$description": "Control borders. 3.42:1 on paper-50, meets WCAG 1.4.11" },
      "500": { "$value": "#78736C" },
      "600": { "$value": "#5C5851" },
      "700": { "$value": "#403C36" },
      "800": { "$value": "#2A2724" },
      "900": { "$value": "#1A1917", "$description": "Primary text and primary action. The brand black." },
      "950": { "$value": "#0F0E0D" }
    },
    "volt": {
      "100": { "$value": "#F2FFD1" },
      "300": { "$value": "#DCFF8A" },
      "500": { "$value": "#C3FF33", "$description": "The Dot. The campaign neon. Max 2% of any screen." },
      "700": { "$value": "#7FAD00" },
      "900": { "$value": "#3F5600", "$description": "The only volt legible as text on paper (7.92:1)" }
    },
    "green": {
      "100": { "$value": "#DCF3E9" }, "300": { "$value": "#8FD9BC" },
      "600": { "$value": "#0E7C55" }, "800": { "$value": "#0A4F37" }
    },
    "amber": {
      "100": { "$value": "#FBEFD9" }, "300": { "$value": "#F0C77A" },
      "600": { "$value": "#8F5A00" }, "800": { "$value": "#6E4400" }
    },
    "red": {
      "100": { "$value": "#FBE5E1" }, "300": { "$value": "#F0A79B" },
      "600": { "$value": "#B0271B" }, "800": { "$value": "#731810" }
    },
    "blue": {
      "100": { "$value": "#E2EEF8" }, "300": { "$value": "#9DC3E4" },
      "600": { "$value": "#1A5C96" }, "800": { "$value": "#123C63" }
    },
    "dark": {
      "bg":       { "$value": "#0F0E0D" },
      "surface":  { "$value": "#1A1917" },
      "raised":   { "$value": "#26231F" },
      "border":   { "$value": "#35312C" },
      "borderHi": { "$value": "#6E6860" },
      "text":     { "$value": "#F5F3EF" },
      "text2":    { "$value": "#A8A29A" }
    }
  },

  "semantic": {
    "$type": "color",
    "$description": "Light theme values. Dark theme overrides live in tokens.css under [data-theme=dark] and prefers-color-scheme.",
    "bg": {
      "canvas":  { "$value": "{colour.paper.50}" },
      "surface": { "$value": "{colour.paper.white}" },
      "sunken":  { "$value": "{colour.paper.100}" },
      "inverse": { "$value": "{colour.ink.900}" }
    },
    "text": {
      "primary":     { "$value": "{colour.ink.900}" },
      "secondary":   { "$value": "{colour.ink.600}" },
      "tertiary":    { "$value": "{colour.ink.500}" },
      "placeholder": { "$value": "{colour.ink.500}" },
      "disabled":    { "$value": "{colour.ink.400}" },
      "inverse":     { "$value": "{colour.paper.50}" }
    },
    "border": {
      "subtle":  { "$value": "{colour.paper.200}" },
      "default": { "$value": "{colour.paper.300}" },
      "control": { "$value": "{colour.ink.450}" },
      "strong":  { "$value": "{colour.ink.900}" }
    },
    "action": {
      "primaryBg": { "$value": "{colour.ink.900}" },
      "primaryFg": { "$value": "{colour.paper.50}" },
      "destructiveBg": { "$value": "{colour.red.600}" },
      "destructiveFg": { "$value": "{colour.paper.white}" }
    },
    "signal": {
      "default": { "$value": "{colour.volt.500}", "$description": "Live, listening, needs-you, active. Nothing else." },
      "text":    { "$value": "{colour.volt.900}" },
      "tint":    { "$value": "{colour.volt.100}" }
    },
    "status": {
      "positiveFg":  { "$value": "{colour.green.800}" },
      "positiveBg":  { "$value": "{colour.green.100}" },
      "attentionFg": { "$value": "{colour.amber.800}" },
      "attentionBg": { "$value": "{colour.amber.100}" },
      "criticalFg":  { "$value": "{colour.red.800}" },
      "criticalBg":  { "$value": "{colour.red.100}" },
      "scheduledFg": { "$value": "{colour.blue.800}" },
      "scheduledBg": { "$value": "{colour.blue.100}" },
      "neutralFg":   { "$value": "{colour.ink.900}", "$description": "Awaiting approval. Deliberately not amber." },
      "neutralBg":   { "$value": "{colour.paper.200}" }
    }
  },

  "font": {
    "$type": "fontFamily",
    "display":   { "$value": ["Archivo", "system-ui", "sans-serif"] },
    "text":      { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] },
    "editorial": { "$value": ["Newsreader", "Georgia", "serif"], "$description": "Daily Brief and long-form only" },
    "mono":      { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },

  "fontSize": {
    "$type": "dimension",
    "2xs":  { "$value": "0.6875rem" }, "xs":  { "$value": "0.75rem" },
    "sm":   { "$value": "0.875rem" },  "base":{ "$value": "1rem" },
    "md":   { "$value": "1.0625rem", "$description": "Reading size for messages and drafts" },
    "lg":   { "$value": "1.25rem" },   "xl":  { "$value": "1.5rem" },
    "2xl":  { "$value": "1.875rem" },  "3xl": { "$value": "2.375rem" },
    "4xl":  { "$value": "3rem" },      "5xl": { "$value": "4rem" }
  },

  "fontWeight": {
    "$type": "fontWeight",
    "regular":  { "$value": 400 }, "medium": { "$value": 500 },
    "semibold": { "$value": 600 }, "bold":   { "$value": 700 },
    "black":    { "$value": 800, "$description": "Display only, never below 24px" }
  },

  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.05 }, "snug": { "$value": 1.2 },
    "normal": { "$value": 1.45 }, "relaxed": { "$value": 1.6 }
  },

  "letterSpacing": {
    "$type": "dimension",
    "tighter": { "$value": "-0.03em" }, "tight": { "$value": "-0.02em" },
    "snug":    { "$value": "-0.01em" }, "normal": { "$value": "0" },
    "wide":    { "$value": "0.02em" },  "widest": { "$value": "0.08em" }
  },

  "space": {
    "$type": "dimension",
    "0": { "$value": "0" },      "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },"4": { "$value": "1rem", "$description": "Default gutter" },
    "5": { "$value": "1.25rem" },"6": { "$value": "1.5rem" },  "8": { "$value": "2rem" },
    "10":{ "$value": "2.5rem" }, "12":{ "$value": "3rem" },    "16":{ "$value": "4rem" },
    "20":{ "$value": "5rem" },   "24":{ "$value": "6rem" }
  },

  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" },  "sm": { "$value": "6px" },  "md": { "$value": "10px" },
    "lg": { "$value": "14px" }, "xl": { "$value": "20px" }, "2xl": { "$value": "28px" },
    "full": { "$value": "999px" }
  },

  "size": {
    "$type": "dimension",
    "controlSm": { "$value": "2.5rem", "$description": "40px. Inline only, never a primary action." },
    "controlMd": { "$value": "3rem",   "$description": "48px. Absolute minimum touch target." },
    "controlLg": { "$value": "3.5rem", "$description": "56px. Mobile default." },
    "controlXl": { "$value": "4rem",   "$description": "64px. Primary action, glove-safe." },
    "iconSm": { "$value": "1rem" }, "iconMd": { "$value": "1.25rem" },
    "iconLg": { "$value": "1.5rem" }, "iconXl": { "$value": "1.75rem" }
  },

  "shadow": {
    "$type": "shadow",
    "1": { "$value": "0 1px 2px rgba(26, 25, 23, 0.06)" },
    "2": { "$value": "0 2px 8px rgba(26, 25, 23, 0.08)" },
    "3": { "$value": "0 8px 24px rgba(26, 25, 23, 0.10)" },
    "4": { "$value": "0 -8px 32px rgba(26, 25, 23, 0.14)" }
  },

  "duration": {
    "$type": "duration",
    "instant": { "$value": "80ms" },  "quick": { "$value": "120ms" },
    "base":    { "$value": "180ms" }, "calm":  { "$value": "240ms" },
    "sheet":   { "$value": "280ms" }
  },

  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter":    { "$value": [0.05, 0.7, 0.1, 1] },
    "exit":     { "$value": [0.3, 0, 0.8, 0.15] }
  },

  "z": {
    "$type": "number",
    "base": { "$value": 0 },   "sticky": { "$value": 100 }, "dock": { "$value": 200 },
    "scrim": { "$value": 300 },"sheet": { "$value": 310 },  "toast": { "$value": 400 },
    "modal": { "$value": 500 }
  }
}
